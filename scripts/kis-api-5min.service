[Unit]
Description=KIS API 5-Minute Execution
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/deriv
# ExecStart calls the wrapper script with cycle argument
ExecStart=/bin/bash /home/opc/deriv/scripts/run_cycle.sh 5min

[Install]
WantedBy=multi-user.target
