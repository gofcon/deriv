[Unit]
Description=KIS API Daily Execution (05:00 AM)
After=network.target

[Service]
Type=oneshot
User=opc
Group=opc
WorkingDirectory=/home/opc/deriv
# ExecStart calls the wrapper script with cycle argument
ExecStart=/bin/bash /home/opc/deriv/scripts/run_cycle.sh daily

[Install]
WantedBy=multi-user.target
